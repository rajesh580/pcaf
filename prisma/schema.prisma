datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  PLATFORM_ADMIN
  COLLEGE_ADMIN
  DEPARTMENT_ADMIN
  FACULTY_COORDINATOR
  STUDENT
  COMPANY_ADMIN
  COMPANY_RECRUITER
  SKILL_PROVIDER
  MENTOR
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  ASSESSMENT
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  INTERVIEW
  SELECTED
  REJECTED
  JOINED
  INTERNSHIP_STARTED
  INTERNSHIP_COMPLETED
  COMPLETED
  WITHDRAWN
}

enum OpportunityType {
  INTERNSHIP
  JOB
}

enum WorkMode {
  ONLINE
  OFFLINE
  HYBRID
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  photoUrl     String?
  passwordHash String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collegeId    String?
  college      College?    @relation("UserCollege", fields: [collegeId], references: [id])
  departmentId String?
  department   Department? @relation("UserDepartment", fields: [departmentId], references: [id])

  studentProfile Student?
  collegeAdmin   College? @relation("CollegeAdmin")
  recruiterAtId  String?
  recruiterAt    Company? @relation("CompanyRecruiter", fields: [recruiterAtId], references: [id])
  trainingEnrollments TrainingEnrollment[]
  publishedTrainingPrograms TrainingProgram[] @relation("TrainingProgramProvider")
}

model College {
  id            String       @id @default(uuid())
  name          String
  code          String       @unique
  university    String
  accreditation String?
  address       String?
  website       String?
  adminUserId   String?      @unique
  adminUser     User?        @relation("CollegeAdmin", fields: [adminUserId], references: [id])
  users         User[]       @relation("UserCollege")
  departments   Department[]
  students      Student[]
  createdAt     DateTime     @default(now())
}

model Department {
  id        String    @id @default(uuid())
  name      String
  code      String
  collegeId String
  college   College   @relation(fields: [collegeId], references: [id])
  users     User[]    @relation("UserDepartment")
  students  Student[]
}

model Student {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id])
  collegeId      String
  college        College         @relation(fields: [collegeId], references: [id])
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id])
  usn            String          @unique
  name           String
  admissionYear  Int
  graduationYear Int
  semester       Int
  cgpa           Float
  backlogs       Int             @default(0)
  resumeUrl      String?
  githubUrl      String?
  linkedinUrl    String?
  skills         StudentSkill[]
  applications   Application[]
  certifications Certification[]
  projects       Project[]
  createdAt      DateTime        @default(now())
}

model Skill {
  id              String             @id @default(uuid())
  name            String             @unique
  category        String
  studentSkills   StudentSkill[]
  jobSkills       OpportunitySkill[]
  trainingCourses TrainingCourse[]
}

model StudentSkill {
  id          String     @id @default(uuid())
  studentId   String
  skillId     String
  level       SkillLevel
  evidenceUrl String?
  student     Student    @relation(fields: [studentId], references: [id])
  skill       Skill      @relation(fields: [skillId], references: [id])

  @@unique([studentId, skillId])
}

model Company {
  id            String        @id @default(uuid())
  name          String
  website       String?
  isVerified    Boolean       @default(false)
  verificationStatus String   @default("PENDING_VERIFICATION")
  recruiters    User[]        @relation("CompanyRecruiter")
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
}

model Opportunity {
  id                String             @id @default(uuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id])
  title             String
  description       String?
  location          String?
  duration          String?
  stipend           String?
  salary            String?
  requiredDegree    String?
  internshipType    String?
  employmentType    String?
  experience        String?
  numberOfPositions  Int                @default(1)
  selectionProcess  String[]            @default([])
  preferredSkills   String[]            @default([])
  status            String              @default("ACTIVE")
  type              OpportunityType
  workMode          WorkMode
  minCgpa           Float              @default(0.0)
  maxBacklogs       Int                @default(0)
  graduationYear    Int
  eligibleDeptCodes String[]
  requiredSkills    OpportunitySkill[]
  applications      Application[]
  deadline          DateTime
  createdAt         DateTime           @default(now())
}

model OpportunitySkill {
  id            String      @id @default(uuid())
  opportunityId String
  skillId       String
  minLevel      SkillLevel
  isMandatory   Boolean     @default(true)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  skill         Skill       @relation(fields: [skillId], references: [id])

  @@unique([opportunityId, skillId])
}

model Application {
  id            String            @id @default(uuid())
  studentId     String
  opportunityId String
  status        ApplicationStatus @default(APPLIED)
  matchScore    Float
  statusTimeline Json                @default("[]")
  selectionRoundDetails Json?
  offerLetterUrl String?
  createdAt     DateTime          @default(now())
  student       Student           @relation(fields: [studentId], references: [id])
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id])

  @@unique([studentId, opportunityId])
}

model TrainingCourse {
  id        String   @id @default(uuid())
  title     String
  provider  String
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id])
  url       String
  duration  String
  createdAt DateTime @default(now())
}

model Certification {
  id        String  @id @default(uuid())
  studentId String
  name      String
  student   Student @relation(fields: [studentId], references: [id])
}

model Project {
  id        String  @id @default(uuid())
  studentId String
  title     String
  student   Student @relation(fields: [studentId], references: [id])
}

model TrainingEnrollment {
  id                      String   @id @default(uuid())
  userId                  String
  programId               String
  programTitle            String
  status                  String   @default("IN_PROGRESS")
  score                   Int?
  testMarks               Int?
  assignmentMarks         Int?
  projectMarks            Int?
  projectTitle            String?
  projectUrl              String?
  assignmentSubmission    String?
  customAssignmentTitle   String?
  customAssignmentDetails String?
  customAssignmentDeadline DateTime?
  feedback                String?
  certificateCode         String?  @unique
  enrolledAt              DateTime @default(now())
  completedAt             DateTime?
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId, status])
}

model TrainingProgram {
  id                  String   @id @default(uuid())
  title               String
  domain              String
  skillsCovered       String[]
  mode                WorkMode @default(ONLINE)
  format              String
  durationWeeks       Int
  provider            String
  providerUserId      String
  assessmentType      String
  assignmentDetails   String?
  testInstructions    String?
  quizQuestions       Json?    @default("[]")
  createdAt           DateTime @default(now())
  providerUser        User     @relation("TrainingProgramProvider", fields: [providerUserId], references: [id], onDelete: Cascade)

  @@index([providerUserId, createdAt])
}
