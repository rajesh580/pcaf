{
  "name": "pfac-portal",
  "version": "1.0.0",
  "description": "Portal for Academia-Industry Collaboration for Skill Mapping, Internships & Placement",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently \"nodemon src/server.js\" \"npm start --prefix client\"",
    "build": "npx prisma generate && npm run build --prefix client",
    "server": "node src/server.js",
    "client": "npm start --prefix client",
    "install:all": "npm install && npm install --prefix client",
    "prisma:generate": "npx prisma generate",
    "prisma:db-push": "npx prisma db push"
  },
  "keywords": [
    "academia",
    "industry",
    "skill-mapping",
    "placement",
    "internship"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.1.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2"
  }
}
